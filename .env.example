ANTHROPIC_API_KEY=

# Optional. CoinGecko Demo API key for higher trending/markets limits.
# Add the same name in the Vercel project settings. The scanner still runs without it.
COINGECKO_DEMO_KEY=

# Optional. Set to true to count recent Reddit mentions as a mild attention add-on.
# Leave unset for v1. Add the same name in the Vercel project settings if you turn it on.
ENABLE_REDDIT_SIGNAL=

# Contact form (Resend, https://resend.com). Server-side only, never prefix with NEXT_PUBLIC_.
# Add the same names in the Vercel project settings.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where each submission is delivered.
CONTACT_TO_EMAIL=you@example.com
# Optional. Defaults to Nice Tools <onboarding@resend.dev>. Use a verified domain in production.
CONTACT_FROM=Nice Tools <onboarding@resend.dev>
